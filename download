.lang-ko{display:none}html[data-lang="ko"] .lang-en{display:none}html[data-lang="ko"] .lang-ko{display:inline}html[data-lang="ko"] .block.lang-ko{display:block}html[data-lang="en"] .block.lang-en{display:block}.block.lang-en{display:block}.block.lang-ko{display:none}
.hero{padding:76px 0 90px;min-height:calc(100vh - var(--header));display:grid;align-items:center}.hero-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:70px;align-items:center}.eyebrow{margin:0 0 16px;color:var(--brand);font-size:.74rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.hero h1,.page-hero h1{margin:0;font-size:clamp(3rem,6.8vw,6.5rem);line-height:.96;letter-spacing:-.065em}.gradient{background:linear-gradient(90deg,#315cff 0%,#00a5a8 55%,#8357ff 100%);-webkit-background-clip:text;background-clip:text;color:transparent}.lead{margin:26px 0 0;max-width:760px;color:var(--muted);font-size:clamp(1.03rem,1.55vw,1.2rem)}.hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:30px}.button{min-height:48px;padding:0 18px;border-radius:14px;display:inline-flex;align-items:center;justify-content:center;font-weight:900;font-size:.85rem;transition:.2s}.button.primary{background:var(--text);color:var(--bg)}.button.ghost{border:1px solid var(--line);background:var(--surface)}.button:hover{transform:translateY(-2px)}.social-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.chip{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:var(--surface);font-size:.73rem;color:var(--muted);font-weight:800}.chip:hover{color:var(--text)}
.profile-card{padding:18px;border:1px solid var(--line);border-radius:31px;background:linear-gradient(155deg,color-mix(in srgb,var(--surface) 94%,#3459ff 6%),var(--surface));box-shadow:var(--shadow)}.profile-label{display:flex;align-items:center;justify-content:space-between;font-size:.72rem;color:var(--muted);margin:0 4px 13px}.live{display:inline-flex;gap:7px;align-items:center}.live:before{content:"";width:8px;height:8px;border-radius:50%;background:#22c67a;box-shadow:0 0 0 5px rgba(34,198,122,.12)}.linkedin-stage{height:430px;border-radius:23px;overflow:hidden;background:#eaf0f7;display:grid;place-items:center;position:relative}.linkedin-stage iframe{width:100%;height:430px;border:0;position:relative;z-index:2}.profile-fallback{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:30px;color:#101828}.profile-fallback img{width:190px;height:190px;border-radius:50%;object-fit:cover;box-shadow:0 14px 35px rgba(0,0,0,.12)}.profile-fallback strong{display:block;margin-top:17px}.profile-foot{display:flex;justify-content:space-between;gap:15px;margin:13px 4px 0;color:var(--muted);font-size:.7rem}
.page-hero{padding:88px 0 62px;border-bottom:1px solid var(--line)}.page-hero h1{font-size:clamp(3.2rem,7.4vw,7rem);max-width:1000px}.page-hero .lead{max-width:820px}.crumb{display:flex;gap:9px;align-items:center;color:var(--muted);font-size:.74rem;font-weight:800;margin-bottom:21px}.crumb span{opacity:.45}.section{padding:88px 0}.section.soft{background:var(--surface2)}.section.dark{background:#09101f;color:#edf3ff}.section.dark .muted{color:#a5b2c6}.section-title{max-width:760px;margin-bottom:38px}.section-title h2{margin:0;font-size:clamp(2rem,4vw,4rem);line-height:1.06;letter-spacing:-.05em}.section-title p{margin:16px 0 0;color:var(--muted)}.muted{color:var(--muted)}
.portal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.portal-card{min-height:235px;padding:27px;border-radius:24px;border:1px solid var(--line);background:var(--surface);display:flex;flex-direction:column;justify-content:space-between;transition:.24s}.portal-card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}.portal-card .num{font-size:.68rem;color:var(--muted);font-weight:900;letter-spacing:.1em}.portal-card h3{font-size:1.4rem;letter-spacing:-.035em;margin:28px 0 8px}.portal-card p{margin:0;color:var(--muted);font-size:.86rem}.portal-card .go{margin-top:25px;font-size:.76rem;font-weight:900;color:var(--brand)}
.grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.card{padding:28px;border:1px solid var(--line);border-radius:24px;background:var(--surface)}.card h3{margin:0 0 11px;font-size:1.25rem;letter-spacing:-.03em}.card p{margin:0;color:var(--muted)}.metric{font-size:2.15rem;font-weight:900;letter-spacing:-.05em}.metric-label{font-size:.75rem;color:var(--muted);margin-top:7px}.timeline{display:grid;gap:13px}.timeline-item{display:grid;grid-template-columns:150px 1fr;gap:22px;padding:24px;border-radius:20px;border:1px solid var(--line);background:var(--surface)}.timeline-year{font-size:.75rem;font-weight:900;color:var(--brand)}.timeline-item h3{margin:0 0 7px}.timeline-item p{margin:0;color:var(--muted)}
.credentials{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.credential{padding:22px;border-radius:20px;border:1px solid var(--line);background:var(--surface)}.credential .kicker{font-size:.67rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;font-weight:900}.credential strong{display:block;font-size:1.18rem;margin:14px 0 5px}.credential small{color:var(--muted)}
.research-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.research-card{min-height:320px;padding:29px;border-radius:24px;border:1px solid var(--line);background:var(--surface);position:relative}.research-card .index{position:absolute;top:22px;right:23px;color:var(--muted);font-size:.68rem;font-weight:900}.research-icon{width:51px;height:51px;border-radius:15px;background:var(--surface2);display:grid;place-items:center;font-weight:900;color:var(--brand);font-size:1.2rem}.research-card h3{margin:41px 0 12px;font-size:1.4rem;letter-spacing:-.03em}.research-card p{margin:0;color:var(--muted);font-size:.9rem}.tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:24px}.tags span{padding:6px 9px;border-radius:999px;background:var(--surface2);color:var(--muted);font-size:.66rem;font-weight:900}.pipeline{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;align-items:center}.pipe{padding:19px 12px;border-radius:16px;background:var(--surface);border:1px solid var(--line);text-align:center;font-size:.78rem;font-weight:900}.arrow{text-align:center;color:var(--muted)}
