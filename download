.skill-groups{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.skill-group{padding:27px;border-radius:24px;background:var(--surface);border:1px solid var(--line)}.skill-group h3{margin:0 0 18px}.skill-list{display:flex;gap:8px;flex-wrap:wrap}.skill-list span{padding:9px 11px;border-radius:12px;background:var(--surface2);font-size:.75rem;font-weight:800;color:var(--muted)}
.contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:60px;align-items:start}.contact-card{border:1px solid var(--line);border-radius:24px;background:var(--surface);overflow:hidden}.contact-row{display:flex;justify-content:space-between;gap:18px;padding:21px 23px;border-bottom:1px solid var(--line);transition:.2s}.contact-row:last-child{border-bottom:0}.contact-row[href]:hover{background:var(--surface2)}.contact-row span{color:var(--muted);font-size:.78rem}.contact-row strong{font-size:.82rem;text-align:right}
.site-footer{padding:34px 0 46px;border-top:1px solid var(--line)}.footer-wrap{display:flex;justify-content:space-between;gap:20px;align-items:end}.footer-wrap p{margin:6px 0 0;color:var(--muted);font-size:.74rem}.footer-links{display:flex;gap:17px;color:var(--muted);font-size:.72rem;font-weight:800}.reveal{opacity:0;transform:translateY(18px);transition:.6s ease}.reveal.visible{opacity:1;transform:none}
@media(max-width:980px){.nav{position:fixed;top:var(--header);left:22px;right:22px;display:none;flex-direction:column;align-items:stretch;gap:0;padding:15px;border:1px solid var(--line);border-radius:18px;background:var(--surface);box-shadow:var(--shadow)}.nav.open{display:flex}.nav a{padding:12px}.nav a.active:after{display:none}.nav-toggle{display:block}.hero-grid,.contact-grid{grid-template-columns:1fr}.hero-grid{gap:44px}.profile-card{max-width:560px}.portal-grid,.grid-3,.credentials,.creative-grid{grid-template-columns:repeat(2,1fr)}.pipeline{grid-template-columns:1fr}.arrow{transform:rotate(90deg)}.gallery{columns:2}.publication{grid-template-columns:80px 1fr}.publication a{grid-column:2}}
@media(max-width:680px){.container{width:min(var(--max),calc(100% - 30px))}.brand-copy{display:none}.hero{padding-top:55px}.hero h1,.page-hero h1{font-size:clamp(2.85rem,15vw,4.8rem)}.page-hero{padding-top:61px}.portal-grid,.grid-2,.grid-3,.credentials,.research-grid,.creative-grid,.skill-groups{grid-template-columns:1fr}.timeline-item{grid-template-columns:1fr;gap:7px}.gallery{columns:1}.publication{grid-template-columns:1fr;gap:8px}.publication a{grid-column:auto}.footer-wrap{align-items:start;flex-direction:column}.footer-links{flex-wrap:wrap}.section{padding:68px 0}.linkedin-stage{height:410px}.linkedin-stage iframe{height:410px}}
