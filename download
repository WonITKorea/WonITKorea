
:root{--bg:#f6f8fc;--surface:#ffffff;--surface2:#eef3f9;--text:#101828;--muted:#667085;--line:rgba(16,24,40,.10);--brand:#3459ff;--brand2:#00a6a6;--purple:#7655ff;--shadow:0 22px 60px rgba(26,45,92,.11);--radius:26px;--max:1180px;--header:76px}
